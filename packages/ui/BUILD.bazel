load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//packages/ui:vitest/package_json.bzl", vitest_bin = "bin")

npm_link_all_packages(name = "node_modules")

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    deps = ["//:tsconfig_base"],
)

ts_project(
    name = "ui",
    srcs = glob(
        ["src/**/*.ts*"],
        exclude = ["src/**/*.test.ts"],
    ),
    declaration = True,
    transpiler = "tsc",
    out_dir = "dist",
    root_dir = "src",
    tsconfig = ":tsconfig",
    deps = [
        ":node_modules/@types/react",
        ":node_modules/react",
    ],
)

# Linked as @spike/ui by npm_link_all_packages in dependent packages.
npm_package(
    name = "pkg",
    srcs = [
        "package.json",
        ":ui",
    ],
    visibility = ["//visibility:public"],
)

# tsc fails the ui action on type errors, so building it is the typecheck.
build_test(
    name = "ui_typecheck_test",
    targets = [":ui"],
)

vitest_bin.vitest_test(
    name = "vitest",
    args = ["run"],
    chdir = package_name(),
    data = glob(["src/**/*.ts*"]) + [
        "package.json",
        ":node_modules/vitest",
    ],
)
